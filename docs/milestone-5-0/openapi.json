  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "pb_ plus 64 lowercase hex characters"
      }
    },
    "schemas": {
      "Section": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": ["id", "uuid", "name", "position"]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "website": {
            "type": ["string", "null"]
          },
          "currency": {
            "type": "string",
            "enum": ["RUB", "USD", "EUR", "TRY"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive"]
          },
          "managerUrl": {
            "type": "string",
            "description": "Relative manager path requiring normal admin login."
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "website",
          "currency",
          "status",
          "managerUrl",
          "sections",
          "createdAt",
          "updatedAt"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "sectionId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "number": {
            "type": ["string", "null"]
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expectedResult": {
            "type": ["string", "null"]
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high"]
          },
          "status": {
            "type": "string",
            "enum": ["new", "clarification", "approved", "in_progress", "review", "done"]
          },
          "clientApproved": {
            "type": "boolean"
          },
          "clientApprovedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "estimateHours": {
            "type": ["number", "null"],
            "description": "Only on GET with estimates:read scope."
          },
          "price": {
            "type": ["number", "null"],
            "description": "Only on GET with estimates:read scope."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "projectId",
          "sectionId",
          "number",
          "title",
          "location",
          "description",
          "expectedResult",
          "priority",
          "status",
          "clientApproved",
          "clientApprovedAt"
        ]
      },
      "CreateProject": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "website": {
            "type": ["string", "null"],
            "format": "uri",
            "maxLength": 2048,
            "description": "HTTP or HTTPS only."
          },
          "currency": {
            "type": "string",
            "enum": ["RUB", "USD", "EUR", "TRY"]
          },
          "clientName": {
            "type": ["string", "null"],
            "maxLength": 255
          },
          "clientEmail": {
            "type": ["string", "null"],
            "format": "email",
            "maxLength": 255
          },
          "sourceSystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "description": "Required together with externalId; exact case-sensitive workspace identity."
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S",
            "description": "Required together with sourceSystem."
          }
        },
        "additionalProperties": false,
        "required": ["title"],
        "dependentRequired": {
          "sourceSystem": ["externalId"],
          "externalId": ["sourceSystem"]
        }
      },
      "CreateTask": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high"]
          },
          "expectedResult": {
            "type": ["string", "null"],
            "maxLength": 10000
          }
        },
        "additionalProperties": false,
        "required": ["title", "location", "description", "priority"]
      },
      "Page": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "lastPage": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": ["page", "perPage", "total", "lastPage"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false,
        "required": ["code", "message"]
      },
      "ProjectResult": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Project"
          }
        },
        "additionalProperties": false,
        "required": ["data"]
      },
      "ProjectList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Page"
          }
        },
        "additionalProperties": false,
        "required": ["data", "meta"]
      },
      "TaskResult": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "additionalProperties": false,
        "required": ["data"]
      },
      "TaskList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Page"
          }
        },
        "additionalProperties": false,
        "required": ["data", "meta"]
      },
      "WebhookEvent": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "project.created",
              "project.updated",
              "task.created",
              "task.updated",
              "task.status_changed",
              "task.approved",
              "webhook.test",
              "task.client_comment_created",
              "project.client_comment_created"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "taskId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "actor": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["admin", "client", "integration", "system"]
              },
              "id": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false,
            "required": ["type", "id"]
          },
          "changes": {
            "type": "object",
            "description": "Per-event allowlists in README. Never prices, hours, private notes, clients or file/link secrets."
          },
          "origin": {
            "type": "string",
            "enum": ["ui", "api", "test"]
          },
          "commentId": {
            "type": "string",
            "format": "uuid",
            "description": "Present and required only for the two opt-in client comment events. No text, filenames, URLs or personal fields are included."
          }
        },
        "additionalProperties": false,
        "required": [
          "version",
          "id",
          "type",
          "occurredAt",
          "workspaceId",
          "projectId",
          "taskId",
          "actor",
          "changes",
          "origin"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": ["task.client_comment_created", "project.client_comment_created"]
                }
              },
              "required": ["type"]
            },
            "then": {
              "required": ["commentId"],
              "properties": {
                "origin": {
                  "const": "ui"
                },
                "actor": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "client"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": ["type", "id"],
                  "additionalProperties": false
                },
                "changes": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            },
            "else": {
              "not": {
                "required": ["commentId"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "task.client_comment_created"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "taskId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "project.client_comment_created"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "taskId": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "WebhookProjectFilter": {
        "type": "object",
        "properties": {
          "projectFilter": {
            "type": "string",
            "enum": ["all", "selected"],
            "default": "all",
            "description": "all includes future projects. selected requires a nonempty explicit workspace-owned UUID list."
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true,
            "maxItems": 1000,
            "description": "Foreign/unavailable UUIDs rejected. Empty for all. Removed projects cascade out; selected then fails closed."
          }
        },
        "required": ["projectFilter", "projectIds"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "projectFilter": {
                  "const": "selected"
                }
              }
            },
            "then": {
              "properties": {
                "projectIds": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "projectIds": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  },
  "webhooks": {
    "projectBriefEvent": {
      "post": {
        "description": "Signed outgoing event. Verify raw bytes, timestamp, deduplicate event id, and return 2xx quickly. Header Event contains event type; Delivery is a stable UUID; Timestamp is Unix seconds; Signature is sha256=<hex HMAC>. Delivery is additionally filtered by endpoint project selection before outbox delivery creation and again before sending/retry. webhook.test bypasses selection. Filter changes version/cancel all pending deliveries; old failed deliveries cannot be retried under a new version.",
        "parameters": [
          {
            "name": "X-ProjectBrief-Event",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-ProjectBrief-Delivery",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-ProjectBrief-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-ProjectBrief-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted (including already processed duplicate)."
          },
          "429": {
            "description": "Retry later."
          },
          "500": {
            "description": "Transient failure; bounded retry."
          }
        }
      }
    }
  }
}
