              },
              "id": {
                "type": ["string", "null"],
                "format": "uuid"
              }
            }
          },
          "changes": {
            "type": "object",
            "maxProperties": 0
          },
          "origin": {
            "enum": ["api", "ui"]
          }
        }
      }
    }
