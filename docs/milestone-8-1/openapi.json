            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "taskId": {
            "type": "null"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": ["pending", "approved", "rejected"]
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "externalId": {
            "type": "string"
          },
          "projectUrl": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "actor": {
            "type": "object",
