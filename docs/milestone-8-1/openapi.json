            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "lastPage": {
                "type": "integer",
                "minimum": 1
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "pending": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
