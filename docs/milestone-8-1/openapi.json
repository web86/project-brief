  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "pb_*"
      }
    },
    "schemas": {
      "ProvisionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId", "client", "project", "sendInvitation"],
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "client": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "email"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 255
              },
              "company": {
                "type": ["string", "null"],
                "maxLength": 255
              },
              "website": {
                "type": ["string", "null"],
                "format": "uri",
                "maxLength": 2048
              }
            }
          },
          "project": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "language"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": ["string", "null"],
                "maxLength": 10000
              },
              "language": {
                "type": "string",
                "enum": ["ru", "en", "tr", "zh-CN"]
              }
            }
          },
          "sendInvitation": {
            "type": "boolean"
          }
        }
      },
      "ProvisionResult": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operationId",
              "projectId",
              "clientId",
              "projectClientId",
              "projectUrl",
              "invitation",
              "created"
            ],
            "properties": {
              "operationId": {
                "type": "string",
                "format": "uuid"
              },
              "projectId": {
                "type": "string",
                "format": "uuid"
              },
              "clientId": {
                "type": "string",
                "format": "uuid"
              },
              "projectClientId": {
                "type": "string",
                "format": "uuid"
              },
              "projectUrl": {
                "type": "string",
                "format": "uri"
              },
              "invitation": {
                "type": "string",
                "enum": ["not_requested", "pending", "sending", "sent", "failed"]
              },
              "created": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "RequestInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["externalId", "client", "project"],
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "client": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "email"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 255
              },
              "company": {
                "type": ["string", "null"],
                "maxLength": 255
              },
              "website": {
                "type": ["string", "null"],
                "format": "uri",
                "maxLength": 2048
              }
            }
          },
          "project": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "language"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": ["string", "null"],
                "maxLength": 10000
              },
              "language": {
                "type": "string",
                "enum": ["ru", "en", "tr", "zh-CN"]
              }
            }
          }
        }
      },
      "RequestCreated": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["id", "requestId", "status", "createdAt"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "enum": ["pending", "approved", "rejected"]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "ProjectRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requestId",
          "externalId",
          "source",
          "client",
          "project",
          "status",
          "createdAt",
          "updatedAt",
          "reviewedAt",
          "decision",
          "result",
          "projectId",
          "clientId",
          "projectUrl",
          "invitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "externalId": {
            "type": "string",
            "maxLength": 160
          },
          "source": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string",
                "maxLength": 100
              }
            }
          },
          "client": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "email"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 255
              },
              "company": {
                "type": ["string", "null"],
                "maxLength": 255
              },
              "website": {
                "type": ["string", "null"],
                "format": "uri",
                "maxLength": 2048
              }
            }
          },
          "project": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "language"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": ["string", "null"],
                "maxLength": 10000
              },
              "language": {
                "type": "string",
                "enum": ["ru", "en", "tr", "zh-CN"]
              }
            }
          },
          "status": {
            "enum": ["pending", "approved", "rejected"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "decision": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": ["actor", "reason", "sendInvitation"],
                "properties": {
                  "actor": {
                    "type": "object",
                    "required": ["type", "id", "name"],
                    "properties": {
                      "type": {
                        "enum": ["admin", "integration"]
                      },
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  "reason": {
                    "type": ["string", "null"],
                    "maxLength": 2000
                  },
                  "sendInvitation": {
                    "type": ["boolean", "null"]
                  }
                }
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operationId",
                  "projectId",
                  "clientId",
                  "projectClientId",
                  "projectUrl",
                  "invitation"
                ],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "projectId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "clientId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "projectClientId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "projectUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "invitation": {
                    "type": "string",
                    "enum": ["not_requested", "pending", "sending", "sent", "failed"]
                  }
                }
              }
            ]
          },
          "projectId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "clientId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "projectUrl": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "invitation": {
            "type": ["string", "null"],
            "enum": ["pending", "sending", "sent", "failed", "not_requested", null]
          }
        }
      },
      "RequestDetail": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProjectRequest"
          }
        }
      },
      "RequestList": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
