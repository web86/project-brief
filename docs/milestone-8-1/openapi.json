      "ProjectRequestWebhook": {
        "type": "object",
        "description": "Existing v1 envelope; only all-project endpoint subscriptions receive request events. No contact data, title/description, reasons or login secrets. HMAC and retry are unchanged.",
        "required": [
          "version",
          "id",
          "type",
          "occurredAt",
          "workspaceId",
          "projectId",
          "taskId",
          "requestId",
          "status",
          "sourceId",
          "externalId",
          "projectUrl",
          "actor",
          "changes",
          "origin"
        ],
        "properties": {
