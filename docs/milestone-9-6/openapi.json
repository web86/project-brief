  "components": {
    "securitySchemes": {
      "agentBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "pb_ + 64 hexadecimal characters"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "assignmentId",
          "projectId",
          "title",
          "taskStatus",
          "executionState",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "taskStatus": {
            "type": "string"
          },
          "executionState": {
            "type": "string",
            "enum": ["pending", "running", "submitted", "failed", "cancelled"]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": ["string", "null"]
          },
          "expectedResult": {
            "type": ["string", "null"]
          },
          "location": {
            "type": ["string", "null"]
          },
          "priority": {
            "type": ["string", "null"]
          }
        }
      },
      "Agent": {
        "type": "object",
        "required": ["id", "name", "kind", "active", "workspaceId", "scopes", "projectIds"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "kind": {
            "type": "string",
            "enum": ["ai", "automation", "service"]
          },
          "active": {
            "type": "boolean"
          },
          "lastActivityAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "agent:profile",
                "agent:tasks:read",
                "agent:tasks:report",
                "agent:comments:create",
                "agent:attachments:create"
              ]
            }
          },
          "projectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ReportInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignmentId", "state", "summary"],
        "properties": {
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "running", "submitted", "failed", "cancelled"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "pullRequestUrl": {
            "type": ["string", "null"],
            "format": "uri",
            "pattern": "^https://[^/@]+(?:/|$)",
            "maxLength": 2048
          },
          "resultUrl": {
            "type": ["string", "null"],
            "format": "uri",
            "pattern": "^https://[^/@]+(?:/|$)",
            "maxLength": 2048
          }
        }
      },
      "CommentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignmentId", "text"],
        "properties": {
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        }
      },
      "AttachmentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assignmentId", "attachments"],
        "properties": {
          "assignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": ["string", "null"],
            "maxLength": 5000
          },
          "attachments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "format": "binary"
            },
            "description": "20 MiB per file, 40 MiB aggregate; extension/MIME/content checks."
          }
        }
      },
      "WriteResult": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["id", "assignmentId", "commentId", "executionState", "attachments"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "assignmentId": {
                "type": "string",
                "format": "uuid"
              },
              "commentId": {
                "type": "string",
                "format": "uuid"
              },
              "executionState": {
                "type": "string",
                "enum": ["pending", "running", "submitted", "failed", "cancelled"]
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
