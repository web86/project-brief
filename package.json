{
  "name": "project-brief",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "cd api && PHP_INI_SCAN_DIR=:$PWD/dev-php php artisan serve --host=127.0.0.1 --port=8000 --quiet",
    "test:appearance": "node tests/appearance.browser.mjs",
    "test:mobile-header": "node tests/mobile-header.browser.mjs",
    "test:branding": "node tests/branding-loading.browser.mjs",
    "brand:generate": "python3 bin/generate-pwa-icons.py",
    "brand:check": "python3 bin/generate-pwa-icons.py --check",
    "preview:public": "vite --config preview/milestone-4-3/vite.config.js",
    "build:public-preview": "vite build --config preview/milestone-4-3/vite.config.js",
    "test:public-preview": "node preview/milestone-4-3/verify.mjs",
    "test:multilingual": "node tests/multilingual.browser.mjs",
    "test:export": "node tests/export.browser.mjs"
  },
  "dependencies": {
    "pdfmake": "0.3.13",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.13",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "prettier": "^3.9.9",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
