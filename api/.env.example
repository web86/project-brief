APP_NAME=ProjectBrief
AI_ENABLED=false
AI_PROVIDER=groq
AI_BRIDGE_URL=https://projectbrief-ai-bridge.web86.deno.net/ai
AI_BRIDGE_SECRET=
ZVENO_API_KEY=
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ZVENO_OUTPUT_MODE=json_schema
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_REQUESTS_PER_MINUTE=5
AI_WORKSPACE_DAILY_LIMIT=50
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=project_brief
DB_USERNAME=project_brief
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=project_brief_session
SESSION_DOMAIN=null
# Production: APP_DEBUG=false, SESSION_SECURE_COOKIE=true; one HTTPS origin.
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Telegram is independent from AI. Telegram is off in each event matrix by default.
TELEGRAM_TRANSPORT=direct
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_TRANSPORT=direct
TELEGRAM_FORWARD_SECRET=
TELEGRAM_DEFAULT_LOCALE=ru
TELEGRAM_WEBHOOK_SECRET=
# Optional isolated Deno endpoint (HTTPS, *.deno.net or *.deno.dev, /telegram/send).
TELEGRAM_BRIDGE_URL=
TELEGRAM_BRIDGE_SECRET=

# Browser PDF JSON requests per session per minute
BROWSER_PDF_RATE_LIMIT=5

# Passkeys default to the host and exact origin of APP_URL (HTTPS in production).
# Set these only when overriding that origin; never derive them from request headers.
# PASSKEY_RP_ID=brief.web86.site
# PASSKEY_ORIGIN=https://brief.web86.site
# Optional long-lived user handle secret; keep stable across APP_KEY rotation.
# PASSKEY_USER_HANDLE_SECRET=
