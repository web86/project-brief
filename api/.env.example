APP_NAME=ProjectBrief
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=project_brief
DB_USERNAME=project_brief
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=project_brief_session
SESSION_DOMAIN=null
# Production: APP_DEBUG=false, SESSION_SECURE_COOKIE=true; one HTTPS origin.
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
